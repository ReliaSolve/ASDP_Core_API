PROJECT_NAME           = "Apache Strap-Down Pilotage Core Libraries"
STRIP_FROM_PATH        = "@CMAKE_CURRENT_SOURCE_DIR@"
OUTPUT_DIRECTORY       = "@CMAKE_CURRENT_BINARY_DIR@/doc_doxygen/"
INPUT                  = "@CMAKE_CURRENT_SOURCE_DIR@/" "@CMAKE_CURRENT_SOURCE_DIR@/docs"
EXAMPLE_PATH           = "@CMAKE_CURRENT_SOURCE_DIR@/examples" "@CMAKE_CURRENT_SOURCE_DIR@/tests_cpp"
IMAGE_PATH             = "@CMAKE_CURRENT_SOURCE_DIR@/docs"
HTML_EXTRA_FILES       = "@CMAKE_CURRENT_SOURCE_DIR@/TR-006v15_Software_Architecture.pdf" "@CMAKE_CURRENT_SOURCE_DIR@/TR-009v06_Core_API_Implementations.pdf"
GENERATE_HTML          = YES
GENERATE_LATEX         = NO
RECURSIVE = YES
EXCLUDE = 
EXCLUDE_PATTERNS = "@CMAKE_CURRENT_SOURCE_DIR@/*.cpp"
USE_MDFILE_AS_MAINPAGE = "@CMAKE_CURRENT_SOURCE_DIR@/README.md"
